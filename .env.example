# ==========================================
# NEXUS WHATSAPP API - ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env and fill with your actual values
# NEVER commit .env file to version control!

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
# For local: postgresql://postgres:password@localhost:5432/nexus_db?schema=public
# For Render: Use the Internal Database URL from Render dashboard
DATABASE_URL="postgresql://user:password@localhost:5432/nexus_db?schema=public"

# ==========================================
# SERVER CONFIGURATION
# ==========================================
# Port for the application (Render uses PORT from environment)
PORT=3000

# Node environment: development, production, test
NODE_ENV=development

# ==========================================
# SECURITY
# ==========================================
# JWT secret key for authentication (MUST be at least 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRITICAL: Change this in production!
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long_change_this

# JWT token expiration (e.g., 24h, 7d, 30d)
JWT_EXPIRES_IN=24h

# ==========================================
# WHATSAPP BUSINESS API (Meta Graph API)
# ==========================================
# Get credentials from: https://developers.facebook.com/apps/
# Documentation: https://developers.facebook.com/docs/whatsapp/cloud-api

# Graph API version (recommended: v21.0 or later)
WHATSAPP_API_VERSION=v21.0

# Your WhatsApp Business Phone Number ID
# Found in: Meta App Dashboard > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Your WhatsApp Business Account ID
# Found in: Meta App Dashboard > WhatsApp > API Setup
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id

# Permanent Access Token for WhatsApp Business API
# Generate in: Meta App Dashboard > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token

# Webhook verification token (create your own secure string)
# Must match the token configured in Meta App Dashboard webhook settings
WHATSAPP_WEBHOOK_VERIFY_TOKEN=nexus_webhook_verify_token_change_this

# ==========================================
# AWS S3 CONFIGURATION
# ==========================================
# AWS credentials and bucket for PDF report storage
# Get from: AWS IAM > Users > Security Credentials
# Permissions needed: s3:PutObject, s3:GetObject, s3:DeleteObject

# AWS region where your S3 bucket is located
AWS_REGION=us-east-1

# AWS Access Key ID
AWS_ACCESS_KEY_ID=your_aws_access_key_id

# AWS Secret Access Key
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# S3 bucket name for storing reports
# Bucket must be created beforehand in AWS S3
AWS_S3_BUCKET_NAME=nexus-reports

# ==========================================
# ANTHROPIC AI (Claude)
# ==========================================
# Get API key from: https://console.anthropic.com/
# Documentation: https://docs.anthropic.com/

# Anthropic API key (starts with sk-ant-)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# Claude model to use
# Options: claude-3-5-sonnet-20241022, claude-3-opus-20240229, claude-3-sonnet-20240229
# Recommended: claude-3-5-sonnet-20241022 (best balance of speed and quality)
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Maximum tokens for AI responses (affects cost and response length)
# Range: 1-4096. Recommended: 1024 for general use
ANTHROPIC_MAX_TOKENS=1024

# ==========================================
# APPLICATION SETTINGS
# ==========================================
# Minutes of inactivity before automatically closing a chat
# Cron job runs every 5 minutes to check for stale chats
CHAT_TIMEOUT_MINUTES=15

# Maximum number of items per page in API responses
MAX_PAGE_SIZE=100

# Default number of items per page when not specified
DEFAULT_PAGE_SIZE=20

# Logging level: error, warn, info, debug
# Use 'info' for production, 'debug' for development
LOG_LEVEL=info

# ==========================================
# RENDER SPECIFIC (for deployment)
# ==========================================
# These are automatically set by Render, don't add them here
# - DATABASE_URL (internal database URL)
# - PORT (automatically assigned by Render)
# - NODE_ENV (set to 'production' automatically)

# ==========================================
# SETUP INSTRUCTIONS
# ==========================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in all the values marked with 'your_*'
# 3. Generate a strong JWT_SECRET (see command above)
# 4. Set up WhatsApp Business API on Meta Developer Platform
# 5. Create AWS S3 bucket and IAM user with appropriate permissions
# 6. Get Anthropic API key from their console
# 7. Run: npm install
# 8. Run: npx prisma migrate dev
# 9. Run: npm run create-admin (to create first admin user)
# 10. Run: npm run dev (development) or npm start (production)

# ==========================================
# SECURITY NOTES
# ==========================================
# - NEVER commit .env file to git
# - Use different credentials for development and production
# - Rotate secrets regularly
# - Use environment variables in CI/CD pipeline
# - Keep .env file permissions restricted (chmod 600 .env)
# - For Render deployment, set variables in Render dashboard

# ==========================================
# TROUBLESHOOTING
# ==========================================
# Application won't start?
#   - Check all CRITICAL variables are set correctly
#   - Verify DATABASE_URL is accessible
#   - Ensure JWT_SECRET is at least 32 characters
#   - Test WhatsApp API token with Meta's API test tool
#   - Verify AWS credentials with: aws s3 ls (if AWS CLI installed)
#
# For more help, see: /docs/02-INSTALACAO.md

