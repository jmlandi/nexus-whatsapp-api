// Schema do banco de dados PostgreSQL
// Define as tabelas e relacionamentos do sistema Nexus

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tabela de Usuários (Admin)
// Armazena usuários que podem acessar o painel administrativo
model User {
  id        String   @id @default(uuid())
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  name      String   @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}

// Tabela de Clientes
// Armazena informações dos clientes da agência WN7
model Customer {
  id          String   @id @default(uuid())
  firstName   String   @map("first_name") @db.VarChar(100)
  lastName    String   @map("last_name") @db.VarChar(100)
  nickname    String?  @db.VarChar(100)
  isActive    Boolean  @default(true) @map("is_active")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relacionamentos
  reports      Report[]
  phoneNumbers PhoneNumber[]
  chats        Chat[]

  @@map("customers")
}

// Tabela de Relatórios
// Armazena referências aos PDFs de relatórios de marketing no S3
model Report {
  id           String   @id @default(uuid())
  customerId   String   @map("customer_id")
  reportUrl    String   @map("report_url") @db.Text
  startDate    DateTime @map("start_date")
  endDate      DateTime @map("end_date")
  observations String?  @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relacionamentos
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([startDate])
  @@index([endDate])
  @@map("reports")
}

// Tabela de Números de Telefone
// Armazena os números de WhatsApp dos clientes
model PhoneNumber {
  id          String   @id @default(uuid())
  customerId  String   @map("customer_id")
  phoneNumber String   @map("phone_number") @db.VarChar(20)
  isActive    Boolean  @default(true) @map("is_active")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relacionamentos
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  chats    Chat[]

  @@unique([customerId, phoneNumber])
  @@index([phoneNumber])
  @@map("phone_numbers")
}

// Tabela de Chats
// Gerencia as conversas ativas ou encerradas
model Chat {
  id            String   @id @default(uuid())
  customerId    String   @map("customer_id")
  phoneNumberId String   @map("phone_number_id")
  isOpen        Boolean  @default(true) @map("is_open")
  updatedAt     DateTime @updatedAt @map("updated_at")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relacionamentos
  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  phoneNumber PhoneNumber   @relation(fields: [phoneNumberId], references: [id], onDelete: Cascade)
  messages    ChatMessage[]

  @@index([customerId])
  @@index([phoneNumberId])
  @@index([isOpen])
  @@map("chats")
}

// Tabela de Mensagens do Chat
// Armazena todas as mensagens trocadas nos chats
model ChatMessage {
  id        String      @id @default(uuid())
  chatId    String      @map("chat_id")
  message   String      @db.Text
  type      MessageType
  updatedAt DateTime    @updatedAt @map("updated_at")
  createdAt DateTime    @default(now()) @map("created_at")

  // Relacionamentos
  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([createdAt])
  @@map("chat_messages")
}

// Enum para tipos de mensagem
enum MessageType {
  user        // Mensagem do usuário
  agent       // Mensagem do agente de IA
  wa_template // Mensagem de template do WhatsApp

  @@map("message_type")
}
